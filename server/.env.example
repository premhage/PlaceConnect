# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB URI)
# Supports local MongoDB (e.g., mongodb://127.0.0.1:27017/placeconnect),
# MongoDB Atlas (mongodb+srv://<user>:<password>@cluster0.mongodb.net/placeconnect),
# Or set USE_IN_MEMORY_DB=true for zero-setup demo & development mode.
MONGODB_URI=mongodb://127.0.0.1:27017/placeconnect
USE_IN_MEMORY_DB=false

# JWT Secret & Cookie Settings
JWT_SECRET=supersecret_jwt_placeconnect_academic_key_2026_dev
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# File Upload Configuration
UPLOAD_DIR=uploads/resumes
MAX_FILE_SIZE_MB=5

# Admin Seed Account Defaults (for createAdmin.js script)
ADMIN_NAME=Placement Director
ADMIN_EMAIL=admin@placeconnect.edu
ADMIN_PASSWORD=Admin@123456
