{
  "name": "placeconnect",
  "version": "1.0.0",
  "description": "PlaceConnect — Online Placement & Recruitment Portal (MERN Stack)",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "create-admin": "npm --prefix server run create-admin",
    "test:server": "npm --prefix server run test",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "vercel-build": "npm --prefix client run build"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "keywords": [
    "mern",
    "placement-portal",
    "recruitment",
    "academic-project"
  ],
  "author": "",
  "license": "ISC"
}
